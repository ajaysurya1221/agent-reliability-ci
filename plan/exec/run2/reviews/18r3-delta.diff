+    journal.write_text("\n".join(rows[:-1]) + "\n" + partial)
+
+    done = run_step("Parse the logs", tmp_path, env)
+    assert done.returncode == 0, done.stderr
+    out = out_dir / "reference-test.json"
+    doc = json.loads(out.read_text())
