diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 765a4a2..86edadd 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -208,13 +208,15 @@ jobs:
       # $GITHUB_STEP_SUMMARY is a per-step file: the runner gives the next step a new, empty one,
       # so the Action step's summary cannot be read from here. Instead run the Action's own gate
       # script (read from action.yml) with fresh summary and output files and an `arci` stub that
-      # prints the report above and exits 1, and require the summary file to hold that report.
+      # prints the report above and exits 1, and require the summary file to hold that report. The
+      # stub also writes a line to stderr, which must reach neither the summary nor the report file.
       - name: Assert the Action's gate script writes the report to the step summary
         run: |
           work="$RUNNER_TEMP/summary-check"
           mkdir -p "$work/bin"
           cp arci-report.md "$work/report.md"
-          printf '#!/usr/bin/env bash\ncat "%s"\nexit 1\n' "$work/report.md" > "$work/bin/arci"
+          printf '#!/usr/bin/env bash\necho STUB-STDERR-LINE >&2\ncat "%s"\nexit 1\n' \
+            "$work/report.md" > "$work/bin/arci"
           chmod +x "$work/bin/arci"
           python - "$work/gate.sh" <<'PY'
           import pathlib
@@ -244,3 +246,9 @@ jobs:
           grep -q "VERDICT: BLOCK" "$work/summary.md"
           cmp "$work/summary.md" "$work/report.md"
           grep -qx "verdict=BLOCK" "$work/output"
+          for file in "$work/summary.md" "$work/arci-report.md"; do
+            if grep -q STUB-STDERR-LINE "$file"; then
+              echo "::error::arci's stderr leaked into $file"
+              exit 1
+            fi
+          done
