+          work="$RUNNER_TEMP/summary-check"
+          mkdir -p "$work/bin"
+          cp arci-report.md "$work/report.md"
+          printf '#!/usr/bin/env bash\necho STUB-STDERR-LINE >&2\ncat "%s"\nexit 1\n' \
+            "$work/report.md" > "$work/bin/arci"
+          chmod +x "$work/bin/arci"
+          python - "$work/gate.sh" <<'PY'
+          import pathlib
+          import sys
+
+          import yaml  # installed with arci by the Action step
+
+          steps = yaml.safe_load(pathlib.Path("action.yml").read_text())["runs"]["steps"]
+          (gate,) = [step for step in steps if step.get("id") == "gate"]
+          assert gate["shell"] == "bash", gate["shell"]
