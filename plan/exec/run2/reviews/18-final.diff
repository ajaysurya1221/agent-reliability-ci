+    "warm_samples": 2,
+    "cold": "each cold sample has its own new, empty UV_CACHE_DIR",
+    "warm": "warm samples reuse the cache the last cold sample filled",
+    "sample_timeout_seconds": 600,
+    "timing_budget_seconds": 2400,
+    "job_timeout_seconds": 2400,
+    "reserve_seconds": 300,
+    "job_start": 1791926838,
