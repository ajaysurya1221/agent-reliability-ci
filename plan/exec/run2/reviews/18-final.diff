+    "uv_cache": "cold",
+    "command_start": None,
+    "demo_banner": None,
+    "demo_verdict": None,
+    "all_steps_held": None,
+    "exit_code": None,
+    "log": None,
+    "timed_out": False,
+    "timeout_reason": None,
+    "started": False,
+    "missing": True,
+}
+# A sample the loop had no time left for, as the timing step writes it.
+NOT_STARTED: dict[str, Any] = {
+    "started": False,
+    "timed_out": True,
+    "timeout_reason": "budget",
+    "timeout_seconds": 0,
+    "demo_banner": None,
