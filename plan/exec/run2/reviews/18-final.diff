+        "samples[0]: incomplete journal line without a 'raw_prefix'",
+    ),
+    "incomplete not a bool": (
+        {"samples": [sample(1, "cold", 60) | {"incomplete": 1}]},
+        "samples[0]: 'incomplete' is 1, not true or false",
