+def _observed_injections(
+    trial: TrialEnvelope, unavailable_starts: Sequence[int]
+) -> Iterator[tuple[str, int | None]]:
+    decision_calls: dict[str, int] = {}
+    for event in trial.events:
+        call_id = event.payload.get("call_id")
+        if unavailable_starts and event.kind == "tool_start":
+            occurrence = event.payload.get("occurrence")
+            if (
+                event.payload.get("tool") == DECISION_TOOL
+                and isinstance(call_id, str)
+                and type(occurrence) is int
+                and occurrence >= 0
+            ):
+                decision_calls[call_id] = occurrence
+        elif event.kind == "tool_finish":
+            name = event.payload.get("injected_by")
+            occurrence = decision_calls.pop(call_id, None) if isinstance(call_id, str) else None
+            if isinstance(name, str) and name:
+                start = None
+                if name == "decision_unavailable" and occurrence is not None:
+                    # The boundary stops at the first eligible before-hook in declaration order.
+                    start = next((at for at in unavailable_starts if at <= occurrence), None)
+                yield name, start
+
