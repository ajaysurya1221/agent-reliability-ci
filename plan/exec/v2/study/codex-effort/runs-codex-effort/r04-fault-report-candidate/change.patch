+def _trial_injections(
+    trial: TrialEnvelope, unavailable_starts: Sequence[int]
+) -> Counter[tuple[str, int | None]]:
+    observed: Counter[tuple[str, int | None]] = Counter()
+    occurrences: dict[str, int] = {}
+    for event in trial.events:
+        payload = event.payload
+        call_id = payload.get("call_id")
+        occurrence = payload.get("occurrence")
+        if (
+            unavailable_starts
+            and event.kind == "tool_start"
+            and payload.get("tool") == DECISION_TOOL
+            and isinstance(call_id, str)
+            and type(occurrence) is int
+        ):
+            occurrences[call_id] = occurrence
+        name = payload.get("injected_by")
+        if event.kind != "tool_finish" or not isinstance(name, str) or not name:
+            continue
+
+        start = None
+        if name == "decision_unavailable" and unavailable_starts:
+            if isinstance(call_id, str):
+                occurrence = occurrences.get(call_id, occurrence)
+            if type(occurrence) is int:
+                # Before-perturbations short-circuit in declaration order.
+                start = next((value for value in unavailable_starts if value <= occurrence), None)
+        observed[name, start] += 1
+    return observed
+
