+def _trial_injections(
+    trial: TrialEnvelope, unavailable_starts: Sequence[int]
+) -> Counter[tuple[str, int | None]]:
+    observed: Counter[tuple[str, int | None]] = Counter()
+    decision_calls: dict[str, int] = {}
+    for event in trial.events:
+        call_id = event.payload.get("call_id")
+        if event.kind == "tool_start" and unavailable_starts:
+            occurrence = event.payload.get("occurrence")
+            if (
+                event.payload.get("tool") == DECISION_TOOL
+                and isinstance(call_id, str)
+                and type(occurrence) is int
+            ):
+                decision_calls[call_id] = occurrence
+        if event.kind != "tool_finish":
+            continue
+        name = event.payload.get("injected_by")
+        if not isinstance(name, str) or not name:
+            continue
+        start = None
+        if (
+            name == "decision_unavailable"
+            and isinstance(call_id, str)
+            and call_id in decision_calls
+        ):
+            # Before-perturbations short-circuit in declaration order.
+            occurrence = decision_calls[call_id]
+            start = next((s for s in unavailable_starts if s <= occurrence), None)
+        observed[name, start] += 1
+    return observed
+
