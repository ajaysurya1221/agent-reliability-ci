+def _trial_injections(
+    trial: TrialEnvelope, unavailable_starts: Sequence[int]
+) -> Counter[tuple[str, int | None]]:
+    """Count finish markers, resolving distinct outage starts by their matching calls."""
+    occurrences: dict[str, int] = {}
+    observed: Counter[tuple[str, int | None]] = Counter()
+    for event in trial.events:
+        payload = event.payload
+        call_id = payload.get("call_id")
+        if (
+            event.kind == "tool_start"
+            and unavailable_starts
+            and payload.get("tool") == DECISION_TOOL
+        ):
+            occurrence = payload.get("occurrence")
+            if isinstance(call_id, str) and type(occurrence) is int:
+                occurrences[call_id] = occurrence
+        name = payload.get("injected_by")
+        if event.kind != "tool_finish" or not isinstance(name, str) or not name:
+            continue
+        start = None
+        if name == "decision_unavailable" and isinstance(call_id, str) and call_id in occurrences:
+            # The boundary stops at the first eligible before-hook in manifest order.
+            occurrence = occurrences[call_id]
+            start = next(
+                (threshold for threshold in unavailable_starts if threshold <= occurrence), None
+            )
+        observed[name, start] += 1
+    return observed
+
