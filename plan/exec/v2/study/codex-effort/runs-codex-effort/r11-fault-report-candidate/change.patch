+def _observed_faults(
+    trial: TrialEnvelope, unavailable_starts: Sequence[int]
+) -> Iterator[tuple[str, int | None]]:
+    decision_calls: dict[str, int] = {}
+    for event in trial.events:
+        payload = event.payload
+        call_id = payload.get("call_id")
+        if (
+            unavailable_starts
+            and event.kind == "tool_start"
+            and payload.get("tool") == DECISION_TOOL
+        ):
+            occurrence = payload.get("occurrence")
+            if isinstance(call_id, str) and type(occurrence) is int:
+                decision_calls[call_id] = occurrence
+        if event.kind != "tool_finish":
+            continue
+        name = payload.get("injected_by")
+        if not isinstance(name, str) or not name:
+            continue
+        start = None
+        if unavailable_starts and name == "decision_unavailable":
+            occurrence = decision_calls.get(call_id) if isinstance(call_id, str) else None
+            if occurrence is not None:
+                # Before-injectors short-circuit in declaration order.
+                start = next((n for n in unavailable_starts if n <= occurrence), None)
+        yield name, start
 
 
