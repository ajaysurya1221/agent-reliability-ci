+def _observed_injections(
+    trial: TrialEnvelope, unavailable_starts: tuple[int, ...]
+) -> Iterator[tuple[str, int | None]]:
+    calls: dict[str, int] = {}
+    for event in trial.events:
+        payload = event.payload
+        call_id = payload.get("call_id")
+        if (
+            unavailable_starts
+            and event.kind == "tool_start"
+            and payload.get("tool") == DECISION_TOOL
+        ):
+            occurrence = payload.get("occurrence")
+            if isinstance(call_id, str) and type(occurrence) is int:
+                calls[call_id] = occurrence
+        if event.kind != "tool_finish":
+            continue
+        name = payload.get("injected_by")
+        if not isinstance(name, str) or not name:
+            continue
+        start = None
+        if unavailable_starts and name == _UNAVAILABLE and isinstance(call_id, str):
+            occurrence = calls.pop(call_id, -1)
+            # The boundary short-circuits at the first eligible before-perturbation.
+            start = next((s for s in unavailable_starts if s <= occurrence), None)
+        yield name, start
+
