+def _observed_injections(
+    trial: TrialEnvelope, starts: Sequence[int]
+) -> Iterator[tuple[str, int | None]]:
+    decision_calls: dict[str, int] = {}
+    for event in trial.events:
+        payload = event.payload
+        call_id = payload.get("call_id")
+        occurrence = payload.get("occurrence")
+        if event.kind == "tool_start":
+            if (
+                starts
+                and payload.get("tool") == DECISION_TOOL
+                and isinstance(call_id, str)
+                and type(occurrence) is int
+            ):
+                decision_calls[call_id] = occurrence
+            continue
+        name = payload.get("injected_by")
+        if event.kind != "tool_finish" or not isinstance(name, str) or not name:
+            continue
+        start = None
+        if starts and name == _UNAVAILABLE and payload.get("tool") in (None, DECISION_TOOL):
+            if isinstance(call_id, str) and call_id in decision_calls:
+                occurrence = decision_calls[call_id]
+            if type(occurrence) is int:
+                # The boundary stops at the first eligible before-hook in declaration order.
+                start = next((threshold for threshold in starts if threshold <= occurrence), None)
+        yield name, start
+
