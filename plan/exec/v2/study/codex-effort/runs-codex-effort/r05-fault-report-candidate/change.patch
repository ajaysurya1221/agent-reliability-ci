+def _observed_faults(
+    trial: TrialEnvelope, unavailable_starts: Sequence[int]
+) -> Counter[tuple[str, int | None]]:
+    observed: Counter[tuple[str, int | None]] = Counter()
+    occurrences: dict[str, int] = {}
+    for event in trial.events:
+        payload = event.payload
+        call_id = payload.get("call_id")
+        if (
+            unavailable_starts
+            and event.kind == "tool_start"
+            and payload.get("tool") == DECISION_TOOL
+        ):
+            occurrence = payload.get("occurrence")
+            if isinstance(call_id, str) and type(occurrence) is int:
+                occurrences[call_id] = occurrence
+        if event.kind != "tool_finish":
+            continue
+        occurrence = occurrences.pop(call_id, None) if isinstance(call_id, str) else None
+        name = payload.get("injected_by")
+        if not isinstance(name, str) or not name:
+            continue
+        start = None
+        if name == "decision_unavailable" and occurrence is not None:
+            # The boundary stops at the first eligible before-hook in declaration order.
+            start = next((s for s in unavailable_starts if s <= occurrence), None)
+        observed[name, start] += 1
+    return observed
+
