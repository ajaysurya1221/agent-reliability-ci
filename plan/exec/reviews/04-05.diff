+
+from __future__ import annotations
+
+import contextlib
+import random
+
+from pydantic import JsonValue
+
+from arci.interfaces import ToolBoxProtocol, ToolFault
+
+
+def run(
+    task: dict[str, JsonValue], tools: ToolBoxProtocol, rng: random.Random
+) -> dict[str, JsonValue]:
